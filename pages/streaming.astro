---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import StreamingTester from "../components/StreamingTester.tsx";

// Read server mode at render time and pass it to the client island.
const serverMode = (import.meta.env.STREAMING_DISABLED === "true" ? "buffer" : "stream") as
  | "stream"
  | "buffer";
---

<Layout
  title="HTTP Streaming"
  description="Test HTTP streaming support and Cache-Control header preservation on Contentstack Launch."
>
  <div class="container" style="padding: 4rem 1.5rem 5rem; max-width: 900px;">

    <!-- Header -->
    <div style="margin-bottom: 2.5rem;">
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <span class="badge badge-ssr">🖥️ SSR Page</span>
        <span class="badge badge-island">⚛️ React Island</span>
        <span class="badge badge-api">🔌 SSE Endpoint</span>
      </div>
      <h1 style="color: #fff; margin-bottom: 1rem;">HTTP Streaming</h1>
      <p style="color: var(--color-text-muted); font-size: 1.05rem; max-width: 68ch;">
        Verifies that HTTP streaming works end-to-end on Contentstack Launch and that
        <code>Cache-Control</code> headers are preserved regardless of whether the server
        is running in <strong>streaming</strong> or <strong>buffer</strong> mode.
      </p>
    </div>

    <!-- How it works -->
    <div class="card" style="margin-bottom: 2rem; border-color: rgba(124,58,237,0.25);">
      <h2 style="color: #fff; font-size: 1rem; margin-bottom: 1rem;">How it works</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        {[
          {
            icon: "📡",
            title: "Streaming mode (default)",
            body: "server.mjs patches res.writeHead to inject Cache-Control just before headers are flushed. The body streams in chunks via Transfer-Encoding: chunked.",
            color: "#10b981",
          },
          {
            icon: "🗄️",
            title: "Buffer mode (STREAMING_DISABLED=true)",
            body: "All res.write() calls are collected in memory. When res.end() fires, Cache-Control is injected, Content-Length is set, and the full response is sent in one shot.",
            color: "#f59e0b",
          },
          {
            icon: "🔁",
            title: "SSE detection",
            body: "server.mjs checks Content-Type: text/event-stream at writeHead time and bypasses buffering for SSE endpoints — they must stream regardless of mode.",
            color: "#06b6d4",
          },
        ].map(item => (
          <div style={`background: rgba(0,0,0,0.25); border-radius: 10px; padding: 1rem; border-left: 3px solid ${item.color};`}>
            <div style="font-size: 1.4rem; margin-bottom: 0.5rem;">{item.icon}</div>
            <strong style={`color: ${item.color}; font-size: 0.82rem; display: block; margin-bottom: 0.4rem;`}>{item.title}</strong>
            <p style="color: var(--color-text-muted); font-size: 0.78rem; margin: 0; line-height: 1.55;">{item.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Interactive tester (React Island) -->
    <div class="card" style="border-color: rgba(16,185,129,0.25);">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
        <h2 style="font-size: 1.1rem; color: #fff; margin: 0;">Streaming &amp; Headers Tester</h2>
        <span class="badge badge-island">client:load</span>
      </div>
      <StreamingTester serverMode={serverMode} client:load />
    </div>

    <!-- Env var reference -->
    <div style="margin-top: 1.5rem; padding: 1rem; background: rgba(124,58,237,0.06); border-radius: var(--radius-md); border: 1px solid rgba(124,58,237,0.2); font-size: 0.85rem; color: var(--color-text-muted);">
      <strong style="color: #fff;">Environment variable:</strong>
      &nbsp;<code>STREAMING_DISABLED=true</code> switches the server to buffer mode.
      Current mode detected server-side: <code>{serverMode}</code>.
      The <code>X-Streaming-Mode</code> response header echoes this on every request.
    </div>

    <!-- SSE endpoint reference -->
    <div class="card" style="margin-top: 1.5rem; border-color: rgba(6,182,212,0.25);">
      <h3 style="color: #fff; font-size: 0.95rem; margin-bottom: 0.75rem;">📄 SSE Endpoint</h3>
      <pre style="margin: 0; font-size: 0.78rem;"><code>// pages/api/stream.ts
export const prerender = false;

export async function GET() &#123;
  const encoder = new TextEncoder();
  const stream = new ReadableStream(&#123;
    start(controller) &#123;
      // send 5 events × 500 ms apart
      let count = 0;
      const timer = setInterval(() => &#123;
        count++;
        controller.enqueue(encoder.encode(`data: &#123;...&#125;\n\n`));
        if (count >= 5) &#123; controller.close(); clearInterval(timer); &#125;
      &#125;, 500);
    &#125;,
  &#125;);

  return new Response(stream, &#123;
    headers: &#123;
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-store",
      "X-Accel-Buffering": "no",   // stop Nginx from buffering
    &#125;,
  &#125;);
&#125;</code></pre>
    </div>

  </div>
</Layout>
